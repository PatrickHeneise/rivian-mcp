{
  "name": "rivian-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for the Rivian API — vehicle state, OTA status, charging, and more",
  "type": "module",
  "bin": {
    "rivian-mcp": "dist/mcp-server.js",
    "rivian": "dist/cli.js"
  },
  "main": "dist/mcp-server.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "node src/mcp-server.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test 'test/*.test.ts'"
  },
  "keywords": [
    "rivian",
    "mcp",
    "ev",
    "vehicle",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickHeneise/rivian-mcp.git"
  },
  "homepage": "https://github.com/PatrickHeneise/rivian-mcp#readme",
  "bugs": {
    "url": "https://github.com/PatrickHeneise/rivian-mcp/issues"
  },
  "author": "Patrick Heneise",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "chalk": "^5.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "semantic-release": "^25.0.3",
    "typescript": "^7.0.2"
  }
}
